# =========================================================
#  环境变量模板
#  复制为 .env 后填入真实值（.env 已被 .gitignore 忽略）
# =========================================================

# ---------- 云端 ASR（asr.provider = cloud 时需要）----------
# 硅基流动: https://cloud.siliconflow.cn/account/ak
# OpenAI  : https://platform.openai.com/api-keys
ASR_API_KEY=

# ---------- 实时语音翻译（asr.provider = livetranslate 时需要）----------
# 阿里云百炼 DashScope: https://bailian.console.aliyun.com/
# 模型: qwen3.5-livetranslate-flash-realtime（音频直入 → 中文文本出）
DASHSCOPE_API_KEY=

# ---------- 翻译（translate.provider = online 时需要）----------
# DeepSeek: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# ---------- 可选：临时覆盖配置（无需改 config.yaml）----------
# ASR_MODEL=small
# ASR_DEVICE=cuda
# AUDIO_BACKEND=wasapi_loopback
# TRANSLATE_BASE_URL=https://api.deepseek.com/v1
